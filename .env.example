# Copy this file to .env and fill in your values. .env is gitignored.

# MongoDB connection string (Atlas: Connect > Drivers, or mongodb://localhost:27017 for local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name to use (created automatically on first write)
MONGODB_DB=expense-tracker

# Demo mode: every visitor gets a private, auto-filled sandbox with a "Reset demo data" button, and
# sandboxes are deleted after a week of inactivity. Leave this off for development and personal use.
# Only turn it on for a public demo (render.yaml and docker-compose.yml already do).
# DEMO_MODE=true

# Port for the API server (Vite proxies /api to this)
PORT=5181

# Optional: override DNS servers used by Node. Set this if the connection fails with
# "querySrv ECONNREFUSED" (common with VPNs or some routers).
# DNS_SERVERS=8.8.8.8,1.1.1.1
