# Copy this file to .env and fill in your values. .env is gitignored.

# MongoDB connection string (Atlas: Connect > Drivers, or mongodb://localhost:27017 for local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name to use (created automatically on first write)
MONGODB_DB=expense-tracker

# Demo mode: every visitor gets a private, auto-filled sandbox with a "Reset demo data" button, and
# sandboxes are deleted after a week of inactivity. Leave this off for development and personal use.
# Only turn it on for a public demo (render.yaml and docker-compose.yml already do).
# DEMO_MODE=true

# Port for the API server (Vite proxies /api to this)
PORT=5181

# Accounts. Everyone signs in; the first start creates two shared demo accounts, guest1 and guest2
# (password: password). Set this to false for a deployment with real users.
# SEED_GUESTS=false

# The public address of the app. Needed in production: it is where Google / GitHub sign-in sends
# people back to. In development it is the Vite address.
# APP_URL=http://localhost:5180

# How many reverse proxies sit in front of the server (1 on Render). Set it when behind one, so the
# sign-in rate limits and the Secure cookie see the real visitor. Leave it unset when there is none.
# TRUST_PROXY=1

# "Continue with Google" / "Continue with GitHub": create an OAuth app with each provider, register
# <APP_URL>/api/auth/oauth/<google|github>/callback as its redirect URI, and paste the keys here.
# A provider only shows up on the sign-in page when both of its values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: override DNS servers used by Node. Set this if the connection fails with
# "querySrv ECONNREFUSED" (common with VPNs or some routers).
# DNS_SERVERS=8.8.8.8,1.1.1.1
