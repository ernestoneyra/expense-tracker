{
  "name": "expense-report",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm:client\" \"npm:server\"",
    "client": "vite",
    "server": "node --use-system-ca --watch --env-file=.env server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.3.0",
    "mobx": "^7.1.1",
    "mongoose": "^9.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "core-js@2.6.12": true
  }
}
